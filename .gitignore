node_modules

# Per-machine plugin runtime state and LLM chat history (privacy).
# These are written by Athena/Gryphon at runtime and contain user
# conversation content, API session metadata, and per-machine paths.
# Bundle artifacts (main.js, manifest.json, styles.css, hooks/) are
# still tracked — only data and chat-history are excluded.
.obsidian/plugins/athena/data.json
.obsidian/plugins/athena/chat-history.json*
.obsidian/plugins/gryphon/data.json
.obsidian/plugins/gryphon/chat-history.json*
