{
  "schemaVersion": "0.1.0",
  "name": "Athena — X (Tweet)",
  "behavior": "create",
  "noteContentFormat": "{{title}}\n\n*Athena fetches the full tweet (or article) server-side via the syndication CDN.*",
  "properties": [
    { "name": "title", "value": "{{title}}", "type": "text" },
    { "name": "source", "value": "{{url}}", "type": "text" },
    { "name": "clipped_via", "value": "web-clipper-social", "type": "text" },
    { "name": "author", "value": "{{selector:article[data-testid=\"tweet\"] div[data-testid=\"User-Name\"]|first|trim}}", "type": "text" },
    { "name": "clipped_at", "value": "{{time|date:\"YYYY-MM-DDTHH:mm:ssZ\"}}", "type": "datetime" }
  ],
  "triggers": ["/^https:\\/\\/(x|twitter)\\.com\\/[^\\/]+\\/status\\//"],
  "noteNameFormat": "{{title|safe_name}}",
  "path": "inbox/Clippings"
}
