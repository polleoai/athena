#!/usr/bin/env python3
"""Athena kb -- cross-platform command dispatcher.

This is the native entry point on macOS, Linux, and Windows. The dispatch logic
(vault-root resolution, ported-handler routing, Bash-legacy delegation) lives in
bin/lib/kb_dispatch.py. During the Bash->Python migration, un-ported subcommands
are delegated to bin/kb-legacy (POSIX only).

Invoke via the interpreter (`python3 bin/kb ...` / `python bin\\kb ...`) or, on
POSIX, directly via the shebang. The plugin's runMechanical invokes it through
the interpreter so the same entry works on Windows.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))

# Self-heal a broken host interpreter BEFORE importing kb_dispatch (which pulls
# pydantic). If the Python now running kb can't import pydantic but Athena's
# controlled ~/.athena/venv can, re-exec into the venv so ingest works instead
# of crashing deep in the pipeline. Covers the POSIX shebang path and any caller
# that hands us a broken global python; no-op on a healthy/compiled interpreter.
from interpreter_guard import maybe_reexec  # noqa: E402

maybe_reexec()

# Windows consoles default to a legacy code page (typically cp1252) that can't
# encode the non-ASCII characters kb emits (e.g. the "->" arrow rendered as
# U+2192 in "Trashed N file(s) -> .kb-trash/"), raising UnicodeEncodeError.
# Force UTF-8 so output is identical across OSes. No-op on POSIX (already UTF-8)
# and harmless when stdout is a non-reconfigurable capture stream.
if os.name == "nt":
    for _stream in (sys.stdout, sys.stderr):
        try:
            _stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            pass

from kb_dispatch import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
