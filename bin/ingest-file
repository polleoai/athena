#!/usr/bin/env python3
"""ingest-file — thin CLI shim over bin/lib/ingest_url.py.

The URL-file ingest logic (download → arcus_file extraction → raw .md) lives in
the importable module `ingest_url.py` so it compiles into the source-free binary
(Phase 4) and can run in-process from capture.py. This file stays as a
POSIX-invokable entry point (`bin/ingest-file <url>`) that delegates to it.

Usage:
    bin/ingest-file <url>

Exit codes:
    0 — raw markdown + source file written
    1 — detection or download failed
    2 — unsupported type (callers should fall through to other flows)
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))

import ingest_url  # noqa: E402


if __name__ == "__main__":
    ingest_url.main()
