{
  "_comment": "Athena canonical path and convention config. Read by bash (jq), Python (config.py), and the Obsidian plugin at runtime. Change paths here — never hardcode them in code. See bin/lib/config.py for load semantics.",
  "version": 1,

  "raw": {
    "root": "raw",
    "artifacts_subdir": "artifacts",
    "categories": {
      "papers":   { "dir": "raw/papers",   "artifact_exts": [".pdf", ".md"], "source_type": "paper" },
      "repos":    { "dir": "raw/repos",    "artifact_exts": [".md"],  "source_type": "repo" },
      "webpages": { "dir": "raw/webpages", "artifact_exts": [".md"],  "source_type": "webpage" },
      "videos":   { "dir": "raw/videos",   "artifact_exts": [".md"],  "source_type": "video" },
      "images":   { "dir": "raw/images",   "artifact_exts": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"], "source_type": "image" }
    },
    "favicons": { "dir": "raw/favicons", "flat": true },
    "assets":   { "dir": "raw/assets",   "flat": true }
  },

  "wiki": {
    "root": "wiki",
    "format_root": "wiki/format",
    "format_subdirs": ["papers", "repos", "webpages", "videos", "images", "entities"],
    "insights":   "wiki/insights",
    "topics":     "wiki/topics",
    "journal":    "wiki/journal",
    "dashboards": "wiki/dashboards"
  },

  "inbox": {
    "root":         "inbox",
    "url_new":      "inbox/url-new.txt",
    "url_resolved": "inbox/url-resolved.tsv",
    "tracker":      "inbox/URL Tracker.md",
    "clippings_watch_default": ["clippings", "inbox/Clippings"]
  },

  "clip": {
    "_comment": "Web Clipper post-processing. auto_follow_max_links caps how many external links from a social-media clip get fetched (server/athena/server.py:_process_clip). auto_follow_skip_patterns is a list of regex; any external URL matching any pattern is NOT auto-followed (used to avoid capturing marketing landing pages, login screens, download pages).",
    "auto_follow_max_links": 5,
    "auto_follow_skip_patterns": [
      "/download/?(\\?|$)",
      "/pricing/?(\\?|$)",
      "/signup/?(\\?|$)",
      "/sign-up/?(\\?|$)",
      "/signin/?(\\?|$)",
      "/sign-in/?(\\?|$)",
      "/login/?(\\?|$)",
      "/register/?(\\?|$)",
      "/start/?(\\?|$)",
      "/get-started/?(\\?|$)",
      "/contact/?(\\?|$)",
      "^https?://[^/]+/?$",
      "^https?://claude\\.ai(/.*)?$",
      "^https?://chat\\.openai\\.com(/.*)?$",
      "^https?://chatgpt\\.com(/.*)?$",
      "^https?://gemini\\.google\\.com(/.*)?$"
    ]
  },

  "system_files": {
    "contents": "_Contents.md",
    "template": "_TEMPLATE.md",
    "gitkeep":  ".gitkeep",
    "trash":    ".kb-trash"
  },

  "auto_markers": {
    "contents": {
      "start": "<!-- auto-contents:start (generated by kb lint — do not edit inside) -->",
      "end":   "<!-- auto-contents:end -->"
    },
    "members": {
      "start": "<!-- auto-members:start (generated by kb lint — do not edit inside) -->",
      "end":   "<!-- auto-members:end -->"
    }
  },

  "naming": {
    "prefix_separator": ":",
    "description_separator": " — ",
    "filename_max_chars": 100,
    "slug_max_chars": 100,
    "platforms": {
      "x":        { "pattern": "(?://|\\.)(?:x|twitter)\\.com(?:/|$)",       "prefix": "X" },
      "github":   { "pattern": "(?://|\\.)github\\.com/[^/]+/[^/]+",          "prefix": "GitHub" },
      "linkedin": { "pattern": "(?://|\\.)linkedin\\.com(?:/|$)",             "prefix": "LinkedIn" },
      "youtube":  { "pattern": "(?://|\\.)(?:youtube\\.com|youtu\\.be)(?:/|$)","prefix": "YouTube" },
      "arxiv":    { "pattern": "(?://|\\.)arxiv\\.org(?:/|$)",                "prefix": "arXiv" },
      "google_search": { "pattern": "(?://)(?:www\\.)?google\\.[a-z.]+/search\\b", "prefix": "Google" }
    },
    "cloud_storage": {
      "drive":    { "pattern": "drive\\.google\\.com|docs\\.google\\.com",   "prefix": "Drive" },
      "onedrive": { "pattern": "onedrive\\.live\\.com|1drv\\.ms|sharepoint\\.com", "prefix": "OneDrive" },
      "dropbox":  { "pattern": "dropbox\\.com",                               "prefix": "Dropbox" }
    },
    "file_formats": {
      "pdf":  "PDF",
      "docx": "Word", "doc": "Word",
      "xlsx": "Excel", "xls": "Excel",
      "pptx": "PowerPoint", "ppt": "PowerPoint",
      "md":   "Markdown",
      "txt":  "Text",
      "csv":  "CSV"
    },
    "fallback_prefix": "Web",
    "insight_prefix": "Insight",
    "recognized_prefixes": [
      "X", "GitHub", "LinkedIn", "YouTube", "arXiv",
      "Web", "Google", "Drive", "OneDrive", "Dropbox",
      "PDF", "Word", "Excel", "PowerPoint", "Markdown", "Text", "CSV",
      "Insight",
      "BlackHat USA", "BlackHat Asia", "BlackHat Europe", "BlackHat",
      "USENIX", "NDSS", "IEEE S&P"
    ],
    "conference_url_patterns": [
      { "_comment": "BlackHat slide-deck URLs use us-NN/asia-NN/eu-NN where NN is the 2-digit year. Maps to 'BlackHat USA 20NN' etc. body_strip_pattern strips the redundant leading 'Us NN' / 'Asia NN' / 'Eu NN' tokens that the slug-humanizer leaves at the head of the title, so we don't get 'BlackHat USA 2017: Us 17 Robbins ...'.",
        "host_pattern": "(?://|\\.)blackhat\\.com",
        "path_pattern": "/docs/us-(\\d{2})/", "prefix_template": "BlackHat USA 20$1",
        "body_strip_pattern": "^Us\\s+\\d{2}\\s+" },
      { "host_pattern": "(?://|\\.)blackhat\\.com",
        "path_pattern": "/docs/asia-(\\d{2})/", "prefix_template": "BlackHat Asia 20$1",
        "body_strip_pattern": "^Asia\\s+\\d{2}\\s+" },
      { "host_pattern": "(?://|\\.)blackhat\\.com",
        "path_pattern": "/docs/eu-(\\d{2})/", "prefix_template": "BlackHat Europe 20$1",
        "body_strip_pattern": "^Eu\\s+\\d{2}\\s+" },
      { "host_pattern": "(?://|\\.)usenix\\.org",
        "path_pattern": "/conference/([a-z0-9]+)(?:(\\d{2}))?/", "prefix_template": "USENIX $1",
        "body_strip_pattern": "^[A-Z][a-z]+\\s+\\d{2}\\s+" },
      { "host_pattern": "(?://|\\.)ndss-symposium\\.org",
        "path_pattern": "/(?:wp-content/uploads/)?(?:ndss)?(\\d{4})", "prefix_template": "NDSS $1",
        "body_strip_pattern": "^(?:Ndss\\s+)?\\d{4}\\s+" },
      { "host_pattern": "(?://|\\.)ieee-security\\.org",
        "path_pattern": "/TC/SP(\\d+)/", "prefix_template": "IEEE S&P 20$1",
        "body_strip_pattern": "^Sp\\s+\\d+\\s+" }
    ],
    "acronyms": [
      "ACE", "ACL", "DACL", "SACL", "AD", "DC", "DNS", "TLS", "SSL", "API",
      "CVE", "CVSS", "OS", "URL", "URI", "HTTP", "HTTPS", "SQL", "XML",
      "JSON", "YAML", "AI", "ML", "LLM", "GPU", "CPU", "RAM", "ROM",
      "SDK", "MCP", "OAuth", "JWT", "SAML", "LDAP",
      "AWS", "GCP", "K8s", "WMI", "RPC", "SMB", "NTLM", "Kerberos",
      "ICS", "SCADA", "IoT", "OT", "CTF", "RCE", "XSS", "CSRF", "SSRF",
      "RBAC", "ABAC", "MFA", "2FA", "SSO", "IAM", "VPN", "WAF", "IDS", "IPS"
    ],
    "tag_aliases": {
      "_comment": "Map non-canonical tags → canonical ones. kb lint rewrites tags in place using this map before reporting remaining non-canonical tags. Extend via override in bin/config/athena.json when onboarding new vocabulary.",
      "storage": "architecture",
      "pattern": "architecture",
      "graph": "architecture",
      "streams": "architecture",
      "append-only": "architecture",
      "three-layer": "architecture",
      "wikilinks": "architecture",
      "navigation": "architecture",
      "systems": "architecture",
      "knowledge-base": "llm",
      "karpathy": "llm",
      "CLAUDE.md": "prompt-engineering",
      "CLAUDE-md": "prompt-engineering",
      "process": "workflow",
      "cleanup": "workflow",
      "estimation": "workflow",
      "journaling": "workflow",
      "session-logs": "workflow",
      "dogfooding": "meta",
      "identity": "product-design",
      "moat": "product-design",
      "positioning": "product-design",
      "athena-design": "product-design",
      "crystallization": "meta",
      "executive-voice": "writing-style",
      "capture-surface": "workflow",
      "reflect": "workflow",
      "ingest": "workflow",
      "search": "tool",
      "resume": "profile",
      "ai-security": "security"
    }
  }
}
