#!/usr/bin/env python3
"""kb-capture — thin CLI shim over bin/lib/capture.py.

The capture logic (URL routing, per-type handlers, slug/canonical rules, the
byte-exact stdout status lines) lives in the importable module `capture.py` so
the whole ingest path can run in-process — inside a single compiled binary with
no sibling-.py re-exec (Phase 4 of the source-free plan). This file stays as a
POSIX-invokable entry point (`bin/kb-capture <url>`) and as the subject of the
Bash parity oracle (bin/kb-capture-legacy via tests/test_kb_capture_parity.py):
its stdout/exit behaviour is identical to the pre-refactor monolith because it
delegates straight into capture.main().

Usage:
    kb-capture <url>
    kb-capture <url> --desc "..." --keywords "k1,k2" --category "c1,c2"
    kb-capture            (interactive mode — prompts for each field)
"""
from __future__ import annotations

import sys
from pathlib import Path

# capture.py lives beside the other lib modules.
_LIB = str(Path(__file__).resolve().parent / "lib")
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

import capture  # noqa: E402


if __name__ == "__main__":
    try:
        sys.exit(capture.main(sys.argv[1:]))
    except KeyboardInterrupt:
        capture._cleanup()
        sys.exit(130)
